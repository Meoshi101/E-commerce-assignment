---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Tixar Phone Accessories</title>
    <!-- Tailwind CDN -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-gray-50 text-gray-900 font-sans antialiased min-h-screen flex flex-col">

    

    <!-- Main Header -->
    <header class="bg-white border-b border-gray-200 sticky top-0 z-40 shadow-sm">
      <div class="max-w-7xl mx-auto px-4 h-20 flex items-center justify-between gap-4">
        
        <!-- Brand Logo -->
        <a href="/" class="flex items-center gap-2">
          <span class="w-3.5 h-3.5 rounded-full bg-[#059669]"></span>
          <span class="text-2xl font-black tracking-tight text-gray-900">TIXAR</span>
          <span class="text-xs font-bold text-gray-400 uppercase tracking-widest hidden sm:inline">Accessories</span>
        </a>

        <!-- Right Actions -->
        <div class="flex items-center gap-4">
          <a href="/#model" class="text-xs font-semibold text-gray-600 hover:text-[#059669] transition hidden sm:block">
            Revenue Model
          </a>

          <!-- Native Working Cart Trigger -->
          <button 
            id="openCartBtn"
            class="flex items-center gap-2 bg-[#059669] hover:bg-[#047857] text-white px-4 py-2.5 rounded-xl text-sm font-semibold transition shadow-sm cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
              <path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .485.621l-1.5 6A.5.5 0 0 1 13 10H4a.5.5 0 0 1-.485-.379L1.61 3H.5a.5.5 0 0 1-.5-.5zM3.14 4l1.25 5h8.22l1.25-5H3.14zM5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm-7 1a1 1 0 1 1 0 2 1 1 0 0 1 0-2zm7 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
            </svg>
            <span>Cart</span>
            (<span id="navCartCount" class="font-bold">0</span>)
          </button>
        </div>

      </div>
    </header>

    <!-- Page Content Slot -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Slide-Over Shopping Cart Drawer -->
    <div id="cartDrawerBackdrop" class="fixed inset-0 bg-black/50 z-50 hidden transition-opacity"></div>
    <aside id="cartDrawer" class="fixed right-0 top-0 bottom-0 w-full max-w-md bg-white z-50 shadow-2xl flex flex-col transform translate-x-full transition-transform duration-300">
      
      <!-- Cart Header -->
      <div class="p-5 border-b border-gray-100 flex items-center justify-between">
        <h2 class="text-lg font-extrabold text-gray-900">Your Shopping Cart (<span id="drawerCartCount">0</span>)</h2>
        <button id="closeCartBtn" class="text-gray-400 hover:text-gray-700 p-1 rounded-lg text-xl font-bold cursor-pointer">&times;</button>
      </div>

      <!-- Items List -->
      <div id="cartItemsList" class="flex-1 overflow-y-auto p-5 space-y-4">
        <!-- Rendered via JS -->
      </div>

      <!-- Cart Footer / Checkout -->
      <div class="p-5 border-t border-gray-100 bg-gray-50 space-y-3">
        <div class="flex justify-between items-center text-sm">
          <span class="text-gray-500 font-medium">Subtotal</span>
          <span id="cartSubtotal" class="font-black text-gray-900 text-lg">KSh 0</span>
        </div>
        <p class="text-[11px] text-gray-400">Taxes, shipping and delivery calculated at checkout.</p>
        
        <button 
          id="checkoutBtn"
          class="w-full bg-[#059669] hover:bg-[#059669] text-white font-bold py-3.5 rounded-xl transition cursor-pointer shadow-md text-sm"
        >
          Proceed to Checkout
        </button>
      </div>
    </aside>

    <!-- Simulated Checkout Modal -->
    <div id="checkoutModal" class="fixed inset-0 bg-black/60 z-50 hidden flex items-center justify-center p-4">
      <div class="bg-white rounded-2xl max-w-md w-full p-6 text-center space-y-4 shadow-2xl">
        <div class="w-14 h-14 bg-green-100 text-green-600 rounded-full flex items-center justify-center mx-auto text-2xl font-bold">
          ✓
        </div>
        <h3 class="text-xl font-extrabold text-gray-900">Order Placed Successfully!</h3>
        <p class="text-xs text-gray-500 leading-relaxed">
          Thank you for ordering with Tixar Accessories.
        </p>
        <div class="bg-gray-50 p-4 rounded-xl text-left text-xs space-y-1 border border-gray-100">
          <div class="flex justify-between"><span>Payment Method:</span> <strong class="text-gray-900">M-Pesa / Card (Simulated)</strong></div>
          <div class="flex justify-between"><span>Status:</span> <strong class="text-green-600 font-bold">Confirmed</strong></div>
        </div>
        <button id="closeModalBtn" class="w-full bg-gray-900 text-white font-bold py-3 rounded-xl text-xs hover:bg-gray-800 transition cursor-pointer">
          Done & Clear Cart
        </button>
      </div>
    </div>

    <!-- Footer -->
    <footer class="bg-gray-900 text-gray-400 py-10 mt-16 text-center text-xs">
      <div class="max-w-7xl mx-auto px-4 space-y-2">
        <p class="font-semibold text-white">Tixar Phone Accessories &bull; Academic E-Commerce Project</p>
        <p>&copy; 2026 Tixar. All rights reserved. </p>
      </div>
    </footer>

    <!-- Global Native Cart Script -->
    <script is:inline>
      let cart = JSON.parse(localStorage.getItem('tixar_cart') || '[]');

      const openCartBtn = document.getElementById('openCartBtn');
      const closeCartBtn = document.getElementById('closeCartBtn');
      const cartDrawer = document.getElementById('cartDrawer');
      const cartDrawerBackdrop = document.getElementById('cartDrawerBackdrop');
      const cartItemsList = document.getElementById('cartItemsList');
      const navCartCount = document.getElementById('navCartCount');
      const drawerCartCount = document.getElementById('drawerCartCount');
      const cartSubtotal = document.getElementById('cartSubtotal');
      const checkoutBtn = document.getElementById('checkoutBtn');
      const checkoutModal = document.getElementById('checkoutModal');
      const closeModalBtn = document.getElementById('closeModalBtn');

      function saveCart() {
        localStorage.setItem('tixar_cart', JSON.stringify(cart));
        updateCartUI();
      }

      function updateCartUI() {
        const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
        const subtotal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);

        if (navCartCount) navCartCount.textContent = totalItems;
        if (drawerCartCount) drawerCartCount.textContent = totalItems;
        if (cartSubtotal) cartSubtotal.textContent = `KSh ${subtotal.toLocaleString()}`;

        if (!cartItemsList) return;

        if (cart.length === 0) {
          cartItemsList.innerHTML = `
            <div class="text-center py-12 text-gray-400">
              <p class="text-4xl mb-2"></p>
              <p class="text-sm font-medium">Your cart is empty.</p>
            </div>
          `;
          return;
        }

        cartItemsList.innerHTML = cart.map((item, index) => `
          <div class="flex items-center gap-3 bg-gray-50 p-3 rounded-xl border border-gray-100">
            <img src="${item.image}" alt="${item.name}" class="w-16 h-16 object-cover rounded-lg bg-white" />
            <div class="flex-1 min-w-0">
              <h4 class="text-xs font-bold text-gray-900 truncate">${item.name}</h4>
              <p class="text-xs font-extrabold text-[#0052CC8] mt-0.5">KSh ${item.price.toLocaleString()}</p>
              <div class="flex items-center gap-2 mt-2">
                <button onclick="changeQty(${index}, -1)" class="w-6 h-6 bg-white border border-gray-200 rounded text-xs font-bold hover:bg-gray-100 flex items-center justify-center cursor-pointer">-</button>
                <span class="text-xs font-bold">${item.quantity}</span>
                <button onclick="changeQty(${index}, 1)" class="w-6 h-6 bg-white border border-gray-200 rounded text-xs font-bold hover:bg-gray-100 flex items-center justify-center cursor-pointer">+</button>
              </div>
            </div>
            <button onclick="removeItem(${index})" class="text-gray-400 hover:text-red-500 text-sm p-1 cursor-pointer">&times;</button>
          </div>
        `).join('');
      }

      window.changeQty = function(index, delta) {
        cart[index].quantity += delta;
        if (cart[index].quantity <= 0) cart.splice(index, 1);
        saveCart();
      };

      window.removeItem = function(index) {
        cart.splice(index, 1);
        saveCart();
      };

      window.addToCart = function(product) {
        const existing = cart.find(i => i.id === product.id);
        if (existing) {
          existing.quantity += 1;
        } else {
          cart.push({ ...product, quantity: 1 });
        }
        saveCart();
        openDrawer();
      };

      function openDrawer() {
        cartDrawer.classList.remove('translate-x-full');
        cartDrawerBackdrop.classList.remove('hidden');
      }

      function closeDrawer() {
        cartDrawer.classList.add('translate-x-full');
        cartDrawerBackdrop.classList.add('hidden');
      }

      if (openCartBtn) openCartBtn.addEventListener('click', openDrawer);
      if (closeCartBtn) closeCartBtn.addEventListener('click', closeDrawer);
      if (cartDrawerBackdrop) cartDrawerBackdrop.addEventListener('click', closeDrawer);

      if (checkoutBtn) {
        checkoutBtn.addEventListener('click', () => {
          if (cart.length === 0) {
            alert('Your cart is empty! Add an item before checking out.');
            return;
          }
          closeDrawer();
          checkoutModal.classList.remove('hidden');
        });
      }

      if (closeModalBtn) {
        closeModalBtn.addEventListener('click', () => {
          cart = [];
          saveCart();
          checkoutModal.classList.add('hidden');
        });
      }

      // Initialize on page load
      updateCartUI();
    </script>
  </body>
</html>