---
import Layout from '../layouts/Layout.astro';
import products from '../data/products.json';

const tally = (key) => Object.entries(products.reduce((a, p) => { a[p[key]] = (a[p[key]] || 0) + 1; return a; }, {}));
const categories = tally('category');
const brands = tally('brand');
---
<Layout title="Accessories">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6">

    <!-- Premium storefront hero -->
    <section >
      
      <div class="grid grid-cols-1 lg:grid-cols-2 items-center gap-8 lg:gap-12 px-7 py-14 sm:px-12 sm:py-20 lg:px-16 lg:py-24 relative">
        <div class="max-w-xl">
          <span class="inline-flex items-center gap-2 bg-white/90 border border-blue-100 text-[#0052CC] text-xs font-extrabold uppercase tracking-[0.15em] px-4 py-2 rounded-full mb-7 shadow-sm">
            <span class="h-2 w-2 rounded-full bg-[#059669]"></span> Tixar Phone Accessories
          </span>
          <h1 class="text-[clamp(2.7rem,5vw,5rem)] font-black tracking-tight text-[#1E293B] leading-[1.08]">
            The Right Accessories.<br /><span class="text-[#0052CC]">The Right Connection.</span>
          </h1>
          <p class="text-base sm:text-lg text-[#64748B] mt-7 max-w-lg leading-relaxed">
            Upgrade your everyday with carefully selected earbuds, chargers, cases and more. Stay connected in style.
          </p>
          <div class="flex flex-wrap gap-3 mt-9">
            <a href="#product-grid" class="inline-flex items-center justify-center bg-[#0052CC] hover:bg-[#003D99] text-white px-8 py-4 rounded-full text-sm font-bold transition-all hover:-translate-y-0.5 shadow-lg shadow-blue-200">Shop Now <span class="ml-3" aria-hidden="true">→</span></a>
            <a href="#collection" class="inline-flex items-center justify-center border-2 border-[#1E293B] text-[#1E293B] hover:bg-[#1E293B] hover:text-white px-8 py-4 rounded-full text-sm font-bold transition-all">Explore Collection</a>
          </div>
          <div class="flex flex-wrap items-center gap-x-6 gap-y-3 mt-10 text-sm text-slate-600 font-medium">
            <span>✓ Quality accessories</span><span>✓ Great everyday value</span>
          </div>
        </div>
        <div class="relative flex items-center justify-center min-h-[300px] sm:min-h-[420px]">
          <div class="absolute w-[78%] aspect-square rounded-full bg-gradient-to-br from-blue-100 to-emerald-100/70"></div>
          {products.length > 0 && (
            <img src={products[0].image} alt={products[0].name} fetchpriority="high" class="relative z-10 w-full max-w-[470px] h-[310px] sm:h-[450px] object-contain drop-shadow-2xl hover:scale-105 transition-transform duration-500" />
          )}
          <div class="absolute z-20 bottom-2 right-0 sm:right-3 bg-white/95 backdrop-blur border border-slate-100 rounded-2xl shadow-xl px-5 py-4">
            <p class="text-[10px] uppercase tracking-widest text-slate-500 font-bold">Discover</p>
            <p class="text-lg font-black text-[#0052CC]">Your next upgrade</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Store benefits -->
    <section aria-label="Why shop with Tixar" class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-12">
      <div class="bg-white border border-slate-200 rounded-2xl p-5 flex items-center gap-4"><span class="text-2xl" aria-hidden="true"></span><div><h2 class="font-bold text-[#1E293B]">Everyday essentials</h2><p class="text-sm text-slate-500">Accessories for your daily life</p></div></div>
      <div class="bg-white border border-slate-200 rounded-2xl p-5 flex items-center gap-4"><span class="text-2xl" aria-hidden="true"></span><div><h2 class="font-bold text-[#1E293B]">Explore top picks</h2><p class="text-sm text-slate-500">Find your perfect fit</p></div></div>
      <div class="bg-white border border-slate-200 rounded-2xl p-5 flex items-center gap-4"><span class="text-2xl" aria-hidden="true"></span><div><h2 class="font-bold text-[#1E293B]">Made for connection</h2><p class="text-sm text-slate-500">Stay powered and connected</p></div></div>
    </section>

   

    <div id="collection" class="mb-7 scroll-mt-24">
      <span class="text-xs font-extrabold tracking-[0.2em] uppercase text-[#059669]">Find your favourites</span>
      <h2 class="text-3xl sm:text-4xl font-black tracking-tight text-[#1E293B] mt-2">Explore Our Collection</h2>
      <p class="text-sm text-[#64748B] mt-1"><span id="product-count">{products.length}</span> products available</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      <!-- Filters (counts calculated from the data) -->
      <aside>
        <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm lg:sticky lg:top-24">
          <div class="flex items-center justify-between pb-3 border-b border-gray-100 mb-4">
            <h3 class="font-bold text-sm">Filters</h3>
            <button id="reset-filters" class="text-xs text-[#0052CC] font-medium hover:underline cursor-pointer">Clear All</button>
          </div>

          <h4 class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-3">Category</h4>
          <div class="space-y-2 text-sm text-gray-600 mb-6">
            {categories.map(([name, n]) => (
              <label class="flex items-center justify-between cursor-pointer hover:text-gray-900">
                <span class="flex items-center gap-2"><input type="checkbox" value={name} class="category-checkbox rounded accent-[#0052CC]" />{name}</span>
                <span class="text-xs text-gray-400">({n})</span>
              </label>
            ))}
          </div>

          <h4 class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-3">Brand</h4>
          <div class="space-y-2 text-sm text-gray-600">
            {brands.map(([name, n]) => (
              <label class="flex items-center justify-between cursor-pointer hover:text-gray-900">
                <span class="flex items-center gap-2"><input type="checkbox" value={name} class="brand-checkbox rounded accent-[#0052CC]" />{name}</span>
                <span class="text-xs text-gray-400">({n})</span>
              </label>
            ))}
          </div>
        </div>
      </aside>

      <section class="lg:col-span-3">
        <!-- Search and sort bar -->
        <div class="flex flex-col sm:flex-row sm:items-center gap-3 bg-white p-4 rounded-2xl border border-gray-200 shadow-sm mb-6">
          <input id="searchInput" type="search" placeholder="🔍 Search products, brands or categories..." class="flex-1 text-sm border border-gray-200 rounded-lg px-3 py-2 bg-gray-50 focus:outline-none focus:ring-2 focus:ring-[#0052CC]" />
          <div class="flex items-center gap-2">
            <label class="text-xs text-gray-500">Sort by:</label>
            <select id="sort-select" class="text-xs border border-gray-200 rounded-lg px-2.5 py-2 bg-gray-50 focus:outline-none focus:ring-2 focus:ring-[#0052CC]">
              <option value="featured">Featured First</option>
              <option value="low-high">Price: Low to High</option>
              <option value="high-low">Price: High to Low</option>
            </select>
          </div>
        </div>

        <div id="product-grid" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6 scroll-mt-28">
          {products.map((item, index) => (
            <div class="product-card bg-white border border-[#E2E8F0] rounded-3xl overflow-hidden hover:shadow-xl hover:-translate-y-1 hover:border-[#0052CC]/30 transition-all duration-300 flex flex-col relative group"
              data-index={index} data-category={item.category} data-brand={item.brand} data-price={item.price}
              data-name={`${item.name} ${item.brand} ${item.category}`.toLowerCase()}>
              <button data-wish={item.id} aria-label="Save to wishlist" class="absolute top-3 right-3 p-2 rounded-full bg-white/80 hover:bg-white text-gray-400 hover:text-red-500 shadow-sm transition z-10 cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>
              </button>
              <a href={`/product/${item.id}`} class="h-72 bg-gradient-to-b from-[#F3F7FF] to-[#F8FAFC] flex items-center justify-center overflow-hidden block p-7">
                <img src={item.image} alt={item.name} loading="lazy" class="h-full w-full object-contain group-hover:scale-110 transition duration-500" />
              </a>
              <div class="p-5 flex-1 flex flex-col justify-between">
                <div>
                  <span class="text-[11px] font-bold text-gray-400 uppercase tracking-wider">{item.brand}</span>
                  <a href={`/product/${item.id}`} class="hover:text-[#0052CC] transition block">
                    <h3 class="text-sm font-bold text-[#1E293B] mt-2 line-clamp-2 leading-relaxed uppercase">{item.name.trim()}</h3>
                  </a>
                </div>
                <div class="mt-4 pt-3 border-t border-gray-100">
                  <div class="text-lg font-extrabold text-[#1E293B]">KSh {item.price.toLocaleString()}</div>
                  <button data-add={item.id} class="mt-4 w-full bg-[#059669] hover:bg-[#047857] text-white text-sm font-bold py-3.5 rounded-full transition cursor-pointer">+ Add to Cart</button>
                </div>
              </div>
            </div>
          ))}
        </div>
        <p id="no-results" class="hidden text-center text-gray-500 py-16">No products match your search. Try clearing the filters.</p>
      </section>
    </div>
    <!-- Group members (required on the front page) -->
    <section class="bg-white border border-gray-200 rounded-2xl p-6 mb-10">
      <h2 class="text-lg font-extrabold text-[#1E293B]">Group Members</h2>
      <p class="text-xs text-gray-500 mb-3">E-commerce Group Assignment, Kirinyaga University</p>
      <div class="overflow-x-auto">
        <table class="w-full text-sm text-left">
          <thead class="bg-gray-900 text-white"><tr><th class="px-3 py-2">#</th><th class="px-3 py-2">Name</th><th class="px-3 py-2">Admission No.</th></tr></thead>
          <tbody class="divide-y divide-gray-100">
            <tr><td class="px-3 py-2">1</td><td class="px-3 py-2">GIKARA STACY KEMUMA</td><td class="px-3 py-2">PA106/G/28661/25.</td></tr>
            <tr><td class="px-3 py-2">2</td><td class="px-3 py-2">FARAJA MEOSHI</td><td class="px-3 py-2">PA106/G/28662/25.</td></tr>
            <tr><td class="px-3 py-2">3</td><td class="px-3 py-2">WANJIKU MANASSEH MWIRIGI</td><td class="px-3 py-2">PA106/G/27832//25.</td></tr>
            <tr><td class="px-3 py-2">4</td><td class="px-3 py-2">ANNEX KIPRUTO</td><td class="px-3 py-2">PA106/G/28669/25.</td></tr>
            <tr><td class="px-3 py-2">5</td><td class="px-3 py-2">KAINGO DANSON MUTWIRI</td><td class="px-3 py-2">PA106/G/27833/25.</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Revenue model -->
    <section id="model" class="mt-20 scroll-mt-24">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-[#1E293B]">How Tixar Makes Money</h2>
      <p class="text-sm text-[#64748B] mt-1 mb-6">Our value creation model: low costs, repeat buyers and several income streams.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white border border-gray-200 rounded-2xl p-5"><p class="text-2xl"></p><h3 class="font-bold mt-2">Product margin</h3><p class="text-xs text-gray-500 mt-1">Buy at wholesale, sell at retail with a 30–50% margin on accessories.</p></div>
        <div class="bg-white border border-gray-200 rounded-2xl p-5"><p class="text-2xl"></p><h3 class="font-bold mt-2">Bundles and upsells</h3><p class="text-xs text-gray-500 mt-1">Cases with protectors, chargers with cables: bigger baskets per order.</p></div>
        <div class="bg-white border border-gray-200 rounded-2xl p-5"><p class="text-2xl"></p><h3 class="font-bold mt-2">Delivery fees</h3><p class="text-xs text-gray-500 mt-1">Free in Nairobi, small fee for upcountry and same-day orders.</p></div>
        <div class="bg-white border border-gray-200 rounded-2xl p-5"><p class="text-2xl"></p><h3 class="font-bold mt-2">Brand promotions</h3><p class="text-xs text-gray-500 mt-1">Brands pay for featured placement, plus extended warranty plans.</p></div>
      </div>
    </section>
  </div>

  <script is:inline>
    const searchInput = document.getElementById('searchInput');
    const catBoxes = document.querySelectorAll('.category-checkbox');
    const brandBoxes = document.querySelectorAll('.brand-checkbox');
    const cards = Array.from(document.querySelectorAll('.product-card'));
    const countEl = document.getElementById('product-count');
    const grid = document.getElementById('product-grid');
    const sortSelect = document.getElementById('sort-select');
    const noResults = document.getElementById('no-results');

    function applyFilters() {
      const q = searchInput.value.trim().toLowerCase();
      const cats = [...catBoxes].filter(c => c.checked).map(c => c.value);
      const brs = [...brandBoxes].filter(b => b.checked).map(b => b.value);
      let n = 0;
      cards.forEach(card => {
        const ok = (!q || card.dataset.name.includes(q))
          && (!cats.length || cats.includes(card.dataset.category))
          && (!brs.length || brs.includes(card.dataset.brand));
        card.style.display = ok ? 'flex' : 'none';
        if (ok) n++;
      });
      countEl.textContent = n;
      noResults.classList.toggle('hidden', n > 0);
    }

    function applySort() {
      const v = sortSelect.value;
      [...cards].sort((a, b) =>
        v === 'low-high' ? a.dataset.price - b.dataset.price
        : v === 'high-low' ? b.dataset.price - a.dataset.price
        : a.dataset.index - b.dataset.index
      ).forEach(el => grid.appendChild(el));
    }

    searchInput.addEventListener('input', applyFilters);
    [...catBoxes, ...brandBoxes].forEach(cb => cb.addEventListener('change', applyFilters));
    sortSelect.addEventListener('change', applySort);
    document.getElementById('reset-filters').addEventListener('click', () => {
      [...catBoxes, ...brandBoxes].forEach(cb => cb.checked = false);
      searchInput.value = '';
      sortSelect.value = 'featured';
      applySort(); applyFilters();
    });
  </script>
</Layout>
