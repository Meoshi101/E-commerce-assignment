
---
import Layout from '../../layouts/Layout.astro';
import products from '../../data/products.json';

export async function getStaticPaths() {
  return products.map((item) => ({
    params: { id: item.id },
    props: { product: item },
  }));
}

const { product } = Astro.props;
---

<Layout title={product.name}>
  <div class="max-w-7xl mx-auto px-4 py-6">

    <!-- Breadcrumbs -->
    <nav class="text-xs text-gray-500 flex items-center gap-2 mb-6">
      <a href="/" class="hover:text-gray-800">Home</a>
      <span>&rsaquo;</span>
      <a href="/#product-grid" class="hover:text-gray-800">Products</a>
      <span>&rsaquo;</span>
      <span>{product.category}</span>
      <span>&rsaquo;</span>
      <span class="text-gray-900 font-semibold truncate max-w-xs">
        {product.name}
      </span>
    </nav>

    <!-- Product Details -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 bg-white p-6 sm:p-10 rounded-2xl border border-gray-200">

      <!-- Product Image -->
      <div class="flex items-center justify-center bg-gray-50 rounded-2xl p-8 border border-gray-100">
        <img
          src={product.image}
          alt={product.name}
          class="w-full max-h-[420px] object-contain rounded-xl hover:scale-105 transition duration-300"
        />
      </div>

      <!-- Product Information -->
      <div class="flex flex-col justify-between">

        <div>
          <span class="text-xs font-bold text-gray-400 uppercase tracking-widest">
            {product.brand || 'Accessories'}
          </span>

          <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 mt-2 leading-snug">
            {product.name}
          </h1>

          <!-- Price -->
          <div class="mt-4">
            <span class="text-3xl font-extrabold text-[#0052CC]">
              KSh {product.price.toLocaleString()}
            </span>
          </div>

          <p class="text-[11px] text-gray-400 mt-1">Inc. V.A.T</p>

          <!-- Description -->
          <p class="text-sm text-gray-600 mt-4 leading-relaxed">
            {product.description}
          </p>

          <!-- Action Buttons -->
          <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-3">

            <!-- Add to Cart -->
            <button
              type="button"
              data-add={product.id}
              class="w-full bg-[#0052CC] hover:bg-[#0747A6] text-white font-bold py-3.5 px-4 rounded-xl text-sm transition shadow-sm cursor-pointer"
            >
              Add to Cart
            </button>

            <!-- Buy Now -->
            <button
              type="button"
              data-buy={product.id}
              class="w-full border-2 border-[#1E293B] hover:bg-[#1E293B] hover:text-white text-[#1E293B] font-bold py-3.5 px-4 rounded-xl text-sm transition cursor-pointer"
            >
              Buy Now
            </button>

          </div>
        </div>

        <!-- Delivery and Warranty -->
        <div class="mt-8 border-t border-gray-100 pt-6 space-y-4 text-xs text-gray-600">

          <div>
            <p class="font-bold text-gray-800">Free Express Delivery</p>
            <p class="text-gray-500">
              Same-day delivery in Nairobi & pickup across country hubs
            </p>
          </div>

          <div class="flex items-center gap-3">
            <span class="text-lg">🛡️</span>
            <div>
              <p class="font-bold text-gray-800">1 Year Official Warranty</p>
              <p class="text-gray-500">
                Full manufacturer replacement warranty included
              </p>
            </div>
          </div>

        </div>

      </div>
    </div>
  </div>
</Layout>
